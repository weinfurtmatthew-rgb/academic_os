{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "academic-os",
  "compatibility_date": "2025-09-01",
  // static site plus one route: /api/canvas-feed (see worker/index.ts)
  "main": "worker/index.ts",
  // `npx wrangler deploy` runs this first, so Cloudflare needs no build settings.
  "build": {
    "command": "npm ci && npm run build"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
